# MCP server process (defaults point at workspace m365-mail build)
MCP_SERVER_COMMAND=node
# Absolute path recommended. Relative paths are resolved from day 16 folder.
# MCP_SERVER_ARGS=../../MCP/mcp/m365-mail/dist/index.js

# Same env Cursor passes to m365-mail (public app ids; tokens stay in ~/.modumup-m365-mail-mcp/)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_REDIRECT_URI=http://127.0.0.1:3845
M365_PREFERRED_ACCOUNT_UPN=

PORT=5015
